# Copy to: ~/.config/mjolnir/server.env
# chmod 600 ~/.config/mjolnir/server.env

MJOLNIR_BIND=127.0.0.1:8787
MJOLNIR_DATA_DIR=/home/REPLACE_ME/.local/share/mjolnir/data
MJOLNIR_ENV=development

# Required when MJOLNIR_ENV=production (or prod)
# MJOLNIR_INGEST_API_KEY=change-me-ingest
# MJOLNIR_STUDIO_API_KEY=change-me-studio

# Optional tuning
# DEFAULT_KICK_THRESHOLD=70
# DEFAULT_BAN_THRESHOLD=90
